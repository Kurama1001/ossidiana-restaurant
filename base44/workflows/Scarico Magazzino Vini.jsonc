{
  "name": "Scarico Magazzino Vini",
  "description": "Quando viene creata una riga d'ordine di categoria vino, scala le bottiglie dal magazzino",
  "trigger": {
    "condition": "${ (.trigger.data.categoria == \"vino\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "RigaOrdine"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "scarico_magazzino_vini",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scaricoMagazzinoVini",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "scaricoMagazzinoVini"
  }
}